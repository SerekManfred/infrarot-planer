{
  "name": "@infrarot/rechenkern",
  "version": "0.11.0",
  "private": true,
  "description": "Rechenkern Infrarot-Planer: raumweise Heizlast (vereinfachtes Verfahren nach dem Prinzip der DIN EN 12831-1)",
