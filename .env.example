# Vorlage für .env – echte Werte nur in .env (steht in .gitignore).
# Zufallswerte erzeugen z. B. mit:  python3 -c "import secrets; print(secrets.token_hex(32))"

POSTGRES_DB=infrarot
POSTGRES_USER=infrarot
# Nur Buchstaben/Ziffern verwenden (wird in die Datenbank-URL eingesetzt)
POSTGRES_PASSWORD=HIER_ZUFALLSWERT_EINTRAGEN

# Mindestens 32 Zeichen
INFRAROT_JWT_GEHEIMNIS=HIER_ZUFALLSWERT_EINTRAGEN

# true im Betrieb (HTTPS über Caddy; auch über den SSH-Tunnel auf http://localhost nehmen Chrome und Firefox das Cookie an)
INFRAROT_COOKIE_SECURE=true
INFRAROT_SITZUNG_STUNDEN=12

# Ports, nur an 127.0.0.1 gebunden
INFRAROT_FRONTEND_PORT=8090
INFRAROT_BACKEND_PORT=8091
